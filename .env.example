# Copia este archivo a `.env` y rellena los valores reales.
# Los IDs prefijados con PUBLIC_ se exponen al cliente (Pixel y GA son IDs públicos por diseño).

# Meta Pixel — Identificador del conjunto de datos de Meta Business Manager
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# n8n — Webhook que recibe el lead form y lo inserta en Supabase
PUBLIC_N8N_LEADS_WEBHOOK=
# Webhook de n8n para el formulario de soporte (/contacto). Guarda en support_tickets.
PUBLIC_N8N_SUPPORT_WEBHOOK=

# Registro self-service (/registro): la cuenta la crea el API (POST /signup/account) detrás del captcha.
# PUBLIC_API_URL: URL del API (sin / al final). Sin ella, /registro muestra "no disponible".
PUBLIC_API_URL=
# Clave PÚBLICA del widget de Cloudflare Turnstile (la secreta va solo en el API). En local, la de prueba (siempre aprueba):
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Registro self-service: días de prueba (botones "Pruébalo gratis") y plan de la landing -> tier_key del catálogo. Sin la variable, todo va a /agenda.
PUBLIC_SIGNUP={"trial_days":14,"plans":{"pocket":"plan_pocket","lite":"plan_lite","full":"plan_full","ultra":"plan_ultra"}}
