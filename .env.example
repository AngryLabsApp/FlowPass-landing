# Copia este archivo a `.env` y rellena los valores reales.
# Los IDs prefijados con PUBLIC_ se exponen al cliente (Pixel y GA son IDs públicos por diseño).

# Meta Pixel — Identificador del conjunto de datos de Meta Business Manager
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# n8n — Webhook que recibe el lead form y lo inserta en Supabase
PUBLIC_N8N_LEADS_WEBHOOK=
# Webhook de n8n para el formulario de soporte (/contacto). Guarda en support_tickets.
PUBLIC_N8N_SUPPORT_WEBHOOK=

# Registro self-service (/registro). Supabase Auth con la clave pública: publishable (sb_publishable_…) o anon legacy.
# NUNCA la service role aquí. Sin estas variables, /registro muestra "no disponible".
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# A dónde lleva el enlace del correo de confirmación.
# Fase 1: https://flow-pass.com/registro/confirmado · Fase 2: https://app.flow-pass.com/auth/confirmar
PUBLIC_SIGNUP_REDIRECT_URL=
